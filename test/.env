#!/bin/bash

#
# MySQL / MariaDB configuration
#
export BATS_MARIADB_DB_DRIVER="mysql"
export BATS_MARIADB_DB_HOST="mariadb"
export BATS_MARIADB_DB_PORT="3306"
export BATS_MARIADB_DB_USER="example"
export BATS_MARIADB_DB_PASSWORD="example"
export BATS_MARIADB_DB_NAME="example"
export BATS_MARIADB_ROOT_DB_PASSWORD="p4ssw0rd"

#
# PHP / Application configuration
#
export BATS_PHP_FPM_MAX_CHILDREN="4"
export BATS_PHP_FPM_REQUEST_MAX_MEMORY_IN_MEGABYTES="128"
export BATS_CONTAINER_HEAP_PERCENT="0.80"
export BATS_PHP_FPM_MAX_CHILDREN_AUTO_RESIZING="true"
export BATS_VARNISH_ENABLED="false"
export BATS_VARNISH_VCL_CONF_CUSTOM="/app/etc/varnish/bats.vcl"
export BATS_PHP_VERSION="8.4.3"
export BATS_AWS_CLI_VERSION="${AWS_CLI_VERSION:-2.22.10}"

#
# Containers configuration
#
export BATS_CONTAINER_NETWORK_NAME="bats-local"
export BATS_APP_TMP_VOLUME_NAME="app_tmp"
export BATS_APP_VAR_VOLUME_NAME="app_var"
export BATS_APP_ETC_VOLUME_NAME="app_etc"
export BATS_APP_BIN_VOLUME_NAME="app_bin"
export BATS_APP_CFG_VOLUME_NAME="app_cfg"
export BATS_APP_SRC_VOLUME_NAME="app_src"
export BATS_UID=$(id -u)
export BATS_NGINX_CONFIG_VOLUME_NAME="nginx_config"
